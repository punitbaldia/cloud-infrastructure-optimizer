  "components": {
    "schemas": {
      "CostPoint": {
        "properties": {
          "date": {
            "type": "string",
            "format": "date",
            "title": "Date"
          },
          "amount": {
            "type": "string",
            "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
            "title": "Amount"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "date",
          "amount"
        ],
        "title": "CostPoint"
      },
      "ExecutionJob": {
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "title": "Id"
          },
          "recommendation_id": {
            "type": "string",
            "format": "uuid",
            "title": "Recommendation Id"
          },
          "status": {
            "type": "string",
            "enum": [
              "queued",
              "running",
              "succeeded",
              "failed",
              "cancelled"
            ],
            "title": "Status"
          },
          "simulated": {
            "type": "boolean",
            "title": "Simulated",
            "default": true
          },
          "message": {
            "type": "string",
            "title": "Message"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "title": "Created At"
          },
          "completed_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Completed At"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "id",
          "recommendation_id",
          "status",
          "message",
          "created_at"
        ],
        "title": "ExecutionJob"
      },
      "ExecutionRequest": {
        "properties": {
          "idempotency_key": {
            "type": "string",
            "format": "uuid",
            "title": "Idempotency Key"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "idempotency_key"
        ],
        "title": "ExecutionRequest"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "Metric": {
        "properties": {
          "value": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Value"
          },
          "unit": {
            "type": "string",
            "title": "Unit"
          },
          "aggregation": {
            "type": "string",
            "enum": [
              "average",
              "maximum",
              "minimum",
              "sum"
            ],
            "title": "Aggregation"
          },
          "sample_count": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Sample Count"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "unit",
          "aggregation",
          "sample_count"
        ],
        "title": "Metric"
      },
      "OverviewResponse": {
        "properties": {
          "data_source": {
            "type": "string",
            "const": "mock",
            "title": "Data Source",
            "default": "mock"
          },
          "currency": {
            "type": "string",
            "title": "Currency"
          },
          "month_to_date_cost": {
            "type": "string",
            "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
            "title": "Month To Date Cost"
          },
          "cost_coverage": {
            "type": "string",
            "title": "Cost Coverage"
          },
          "estimated_monthly_savings": {
            "type": "string",
            "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
            "title": "Estimated Monthly Savings"
          },
          "observed_savings": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$"
              },
              {
                "type": "null"
              }
            ],
            "title": "Observed Savings"
          },
          "resource_count": {
            "type": "integer",
            "title": "Resource Count"
          },
          "open_recommendation_count": {
            "type": "integer",
            "title": "Open Recommendation Count"
          },
          "critical_finding_count": {
            "type": "integer",
            "title": "Critical Finding Count"
          },
          "last_successful_scan_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Last Successful Scan At"
          },
          "daily_costs": {
            "items": {
              "$ref": "#/components/schemas/CostPoint"
            },
            "type": "array",
            "title": "Daily Costs"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "currency",
          "month_to_date_cost",
          "cost_coverage",
          "estimated_monthly_savings",
          "observed_savings",
          "resource_count",
          "open_recommendation_count",
          "critical_finding_count",
          "last_successful_scan_at",
          "daily_costs"
        ],
        "title": "OverviewResponse"
      },
