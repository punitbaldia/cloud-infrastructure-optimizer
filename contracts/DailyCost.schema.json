{
  "additionalProperties": false,
  "properties": {
    "date": {
      "format": "date",
      "title": "Date",
      "type": "string"
    },
    "account_id": {
      "title": "Account Id",
      "type": "string"
    },
    "service": {
      "title": "Service",
      "type": "string"
    },
    "amount": {
      "anyOf": [
        {
          "minimum": 0.0,
          "type": "number"
        },
        {
          "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
          "type": "string"
        }
      ],
      "title": "Amount"
    },
    "currency": {
      "default": "USD",
      "pattern": "^[A-Z]{3}$",
      "title": "Currency",
      "type": "string"
    },
    "cost_basis": {
      "default": "UnblendedCost",
      "title": "Cost Basis",
      "type": "string"
    },
    "estimated": {
      "default": false,
      "title": "Estimated",
      "type": "boolean"
    }
  },
  "required": [
    "date",
    "account_id",
    "service",
    "amount"
  ],
  "title": "DailyCost",
  "type": "object"
}