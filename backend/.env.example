# LOCAL DEMO: SQLite persistence and in-process background jobs.
# Omit DATABASE_URL to use backend/demo.db.
JOB_MODE=local
REDIS_URL=redis://localhost:6379/0
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
EXPLANATION_MODE=mock
ANTHROPIC_API_KEY=
CLAUDE_MODEL=
ADAPTER_MODULE=app.services.mock_provider
